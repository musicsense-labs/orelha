# Copie para %USERPROFILE%\.cloudflared\config.yml e preencha o id do túnel e o hostname.
# Criados por: cloudflared tunnel login  →  cloudflared tunnel create orelha
tunnel: <TUNNEL_ID>
credentials-file: C:\Users\dfcsa\.cloudflared\<TUNNEL_ID>.json

ingress:
  # Tudo (SPA + /api) sai do backend numa porta só; o Angular compilado é servido por ele.
  - hostname: orelha.app
    service: http://localhost:8081
    originRequest:
      # o extrator leva minutos, mas as respostas da API são curtas; o túnel só precisa aguentar upload
      connectTimeout: 30s
      noTLSVerify: true
  - service: http_status:404
