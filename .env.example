# Copie para .env (ignorado pelo git) e preencha. backend/run.ps1 carrega este arquivo antes de subir.
# Token da conta do Hooktheory (POST https://api.hooktheory.com/v1/users/auth devolve "activkey"):
ORELHA_HOOKTHEORY_ACTIVKEY=

# MusicBrainz exige um contato no User-Agent (API aberta, 1 req/s).
ORELHA_MUSICBRAINZ_CONTACT=

# Biblioteca de áudio; vazio = ../data/audio (dentro do repositório).
ORELHA_LIBRARY_DIR=
